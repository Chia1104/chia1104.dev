{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["service"],
  "extends": [
    "//",
    "@chia/api",
    "@chia/auth",
    "@chia/db",
    "@chia/kv",
    "@chia/utils"
  ],
  "tasks": {
    "build": {
      "outputs": [".output/**", "!.output/server/node_modules/**"],
      "env": [
        "WORKFLOW_TARGET_WORLD",
        "WORKFLOW_POSTGRES_URL",
        "WORKFLOW_POSTGRES_JOB_PREFIX",
        "WORKFLOW_POSTGRES_MAX_POOL_SIZE",
        "WORKFLOW_REDIS_URI",
        "INTERNAL_WORKFLOW_SERVICE_ENDPOINT",
        "INTERNAL_WORKFLOW_SERVICE_TOKEN",
        "CORS_ALLOWED_ORIGIN",
        "RESEND_API_KEY",
        "SENTRY_DSN",
        "ZEABUR_SERVICE_ID",
        "RATELIMIT_WINDOW_MS",
        "RATELIMIT_MAX",
        "OPENAI_API_KEY",
        "AI_AUTH_PUBLIC_KEY",
        "AI_AUTH_PRIVATE_KEY",
        "IP_DENY_LIST",
        "IP_ALLOW_LIST",
        "MAINTENANCE_MODE",
        "MAINTENANCE_BYPASS_TOKEN",
        "TIMEOUT_MS",
        "TRIGGER_SECRET_KEY",
        "ANTHROPIC_API_KEY",
        "GENAI_API_KEY",
        "OLLAMA_BASE_URL",
        "AI_GATEWAY_API_KEY",
        "FIRECRAWL_API_KEY"
      ],
      "passThroughEnv": [
        "WORKFLOW_TARGET_WORLD",
        "WORKFLOW_POSTGRES_URL",
        "WORKFLOW_POSTGRES_JOB_PREFIX",
        "WORKFLOW_POSTGRES_MAX_POOL_SIZE",
        "WORKFLOW_REDIS_URI",
        "INTERNAL_WORKFLOW_SERVICE_ENDPOINT",
        "INTERNAL_WORKFLOW_SERVICE_TOKEN",
        "CORS_ALLOWED_ORIGIN",
        "RESEND_API_KEY",
        "SENTRY_DSN",
        "ZEABUR_SERVICE_ID",
        "RATELIMIT_WINDOW_MS",
        "RATELIMIT_MAX",
        "OPENAI_API_KEY",
        "AI_AUTH_PUBLIC_KEY",
        "AI_AUTH_PRIVATE_KEY",
        "IP_DENY_LIST",
        "IP_ALLOW_LIST",
        "MAINTENANCE_MODE",
        "MAINTENANCE_BYPASS_TOKEN",
        "TIMEOUT_MS",
        "TRIGGER_SECRET_KEY",
        "ANTHROPIC_API_KEY",
        "GENAI_API_KEY",
        "OLLAMA_BASE_URL",
        "AI_GATEWAY_API_KEY",
        "FIRECRAWL_API_KEY"
      ]
    }
  }
}
