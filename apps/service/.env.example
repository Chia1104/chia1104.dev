PORT=3005
NODE_ENV=development
ENV=development

THROTTLE_LIMIT=10
THROTTLE_TTL=1000
RATELIMIT_WINDOW_MS=60000
RATELIMIT_MAX=10000
CORS_ALLOWED_ORIGIN=http://localhost:3002,http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001
IP_DENY_LIST=
IP_ALLOW_LIST=
MAINTENANCE_MODE=0

# apps/workflow private origin and its shared token (>= 32 chars). Every queue mutation goes there.
INTERNAL_WORKFLOW_SERVICE_ENDPOINT=http://localhost:3008
INTERNAL_WORKFLOW_SERVICE_TOKEN=local-workflow-control-token-0000000000

DATABASE_URL=
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres
BETA_DATABASE_URL=

CACHE_PROVIDER=redis
REDIS_URI=redis://localhost:6380

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Register this exact callback URL in the Spotify developer dashboard.
SPOTIFY_REDIRECT_URI=http://localhost:3005/api/v1/spotify/oauth/callback
# Generate with: openssl rand -base64 32
SPOTIFY_TOKEN_ENCRYPTION_KEY=
# Deprecated fallback used only when no active Dashboard account exists.
SPOTIFY_REFRESH_TOKEN=

AUTH_SECRET=
AUTH_URL=http://localhost:3005

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ADMIN_ID=
LOCAL_ADMIN_ID=
BETA_ADMIN_ID=

SENTRY_DSN=

AI_GATEWAY_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

AI_AUTH_PUBLIC_KEY=
AI_AUTH_PRIVATE_KEY=

RESEND_API_KEY=

NEXT_PUBLIC_CAPTCHA_PROVIDER="google-recaptcha"
CAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# NEXT_PUBLIC_CAPTCHA_PROVIDER="cloudflare-turnstile"
# CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA

S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET_NAME=

# Same World storage as apps/workflow; this process only reads run state and streams from it.
WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
WORKFLOW_POSTGRES_URL="postgresql://postgres:postgres@localhost:5434/postgres"
WORKFLOW_POSTGRES_JOB_PREFIX="workflow_"
WORKFLOW_POSTGRES_MAX_POOL_SIZE=12
WORKFLOW_REDIS_URI="redis://localhost:6380"

FIRECRAWL_API_KEY=
