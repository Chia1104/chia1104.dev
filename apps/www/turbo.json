{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["www"],
  "extends": ["//", "@chia/integrations", "@chia/services", "@chia/utils"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "SPOTIFY_FAVORITE_PLAYLIST_ID"
      ],
      "passThroughEnv": [
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "SPOTIFY_FAVORITE_PLAYLIST_ID"
      ]
    }
  }
}
