    "@hono/zod-validator": "catalog:hono",
    "@t3-oss/env-core": "catalog:",
    "@workflow-worlds/redis": "catalog:",
    "@workflow/world-postgres": "catalog:",
    "ai": "catalog:ai",
    "firecrawl": "catalog:ai",
    "hono": "catalog:hono",
    "reading-time-estimator": "^2.13.0",
    "workflow": "catalog:",
