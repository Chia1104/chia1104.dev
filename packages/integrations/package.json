  "dependencies": {
    "@aws-sdk/client-s3": "catalog:aws",
    "@aws-sdk/s3-request-presigner": "catalog:aws",
    "@chia/meta": "workspace:*",
    "@chia/ui": "workspace:*",
    "@chia/utils": "workspace:*",
    "@octokit/core": "catalog:",
    "@octokit/graphql": "catalog:",
    "@octokit/request-error": "catalog:",
    "@octokit/types": "catalog:",
    "@t3-oss/env-core": "catalog:env",
    "ky": "catalog:",
    "react-tweet": "catalog:ui",
    "resend": "catalog:email",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
