    },
    "./github/client.public": {
      "types": "./github/client.public.ts",
      "default": "./github/client.public.ts"
    },
    "./github/env": {
      "types": "./github/env.ts",
      "default": "./github/env.ts"
    },
    "./github/profile": {
      "types": "./github/profile.ts",
      "default": "./github/profile.ts"
    },
    "./github/source": {
      "types": "./github/source.ts",
      "default": "./github/source.ts"
    },
    "./spotify": {
      "types": "./spotify/index.ts",
      "default": "./spotify/index.ts"
    },
    "./spotify/env": {
      "types": "./spotify/env.ts",
