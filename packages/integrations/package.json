      "types": "./s3/s3.client.ts",
      "default": "./s3/s3.client.ts"
    },
    "./s3/service": {
      "types": "./s3/s3.service.ts",
      "default": "./s3/s3.service.ts"
    },
    "./email": {
      "types": "./email/index.ts",
      "default": "./email/index.ts"
    },
    "./email/report": {
      "types": "./email/report.ts",
      "default": "./email/report.ts"
    },
    "./email/env": {
      "types": "./email/env.ts",
      "default": "./email/env.ts"
    },
    "./x": {
      "types": "./x/index.ts",
      "default": "./x/index.ts"
    }
