{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./nitro": {
      "types": "./src/nitro.ts",
      "default": "./src/nitro.ts"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./src/logger.ts"
    },
    "./report": {
      "types": "./src/report.ts",
      "default": "./src/report.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type:check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:otel",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:otel",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:otel",
    "@opentelemetry/instrumentation": "catalog:otel",
    "@opentelemetry/instrumentation-http": "catalog:otel",
    "@opentelemetry/instrumentation-pg": "catalog:otel",
    "@opentelemetry/instrumentation-pino": "catalog:otel",
    "@opentelemetry/instrumentation-redis": "catalog:otel",
    "@opentelemetry/instrumentation-runtime-node": "catalog:otel",
    "@opentelemetry/instrumentation-undici": "catalog:otel",
    "@opentelemetry/resources": "catalog:otel",
    "@opentelemetry/sdk-node": "catalog:otel",
    "@opentelemetry/sdk-trace-base": "catalog:otel",
    "@opentelemetry/semantic-conventions": "catalog:otel",
    "@orpc/opentelemetry": "catalog:orpc",
    "@sentry/node-core": "catalog:sentry",
    "@t3-oss/env-core": "catalog:env",
    "import-in-the-middle": "catalog:otel",
    "pino": "catalog:otel",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@types/node": "catalog:",
    "nitro": "catalog:nitro",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
