{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/workflow-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agent-hooks": {
      "types": "./src/agent.hooks.ts",
      "default": "./src/agent.hooks.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./contract": {
      "types": "./src/control.contract.ts",
      "default": "./src/control.contract.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type:check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@chia/ai": "workspace:*",
    "@chia/service-kit": "workspace:*",
    "es-toolkit": "catalog:",
    "workflow": "catalog:workflow",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
