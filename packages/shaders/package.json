{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/shaders",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.tsx",
      "default": "./src/*.tsx"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type:check": "tsc --noEmit",
    "test": "vitest --run",
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "ui-add": "pnpm dlx shadcn-ui add && prettier src --write --list-different"
  },
  "dependencies": {
    "@chia/ui": "workspace:*",
    "@chia/utils": "workspace:*",
    "@react-three/drei": "catalog:three",
    "@react-three/fiber": "catalog:three",
    "leva": "catalog:three",
    "maath": "catalog:three",
    "r3f-perf": "catalog:three",
    "react": "catalog:react-is",
    "react-dom": "catalog:react-is",
    "shaders": "catalog:three",
    "three": "catalog:three"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@testing-library/react": "catalog:testing-library",
    "@types/react": "catalog:react-is",
    "@types/react-dom": "catalog:react-is",
    "@types/three": "catalog:three",
    "tailwindcss": "catalog:tailwindcss",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
