{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./models": {
      "types": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "default": "./src/tools.ts"
    },
    "./prompts": {
      "types": "./src/prompts.ts",
      "default": "./src/prompts.ts"
    },
    "./messages": {
      "types": "./src/messages.ts",
      "default": "./src/messages.ts"
    },
    "./turn": {
      "types": "./src/turn.ts",
      "default": "./src/turn.ts"
    },
    "./compaction": {
      "types": "./src/compaction.ts",
      "default": "./src/compaction.ts"
    },
    "./maintenance": {
      "types": "./src/maintenance.ts",
      "default": "./src/maintenance.ts"
    },
    "./title": {
      "types": "./src/title.ts",
      "default": "./src/title.ts"
    },
    "./complete": {
      "types": "./src/complete.ts",
      "default": "./src/complete.ts"
    },
    "./wire/schema": {
      "types": "./src/wire/schema.ts",
      "default": "./src/wire/schema.ts"
    },
    "./wire/fold": {
      "types": "./src/wire/fold.ts",
      "default": "./src/wire/fold.ts"
    },
    "./wire/replay": {
      "types": "./src/wire/replay.ts",
      "default": "./src/wire/replay.ts"
    },
    "./session/entries": {
      "types": "./src/session/entries.ts",
      "default": "./src/session/entries.ts"
    },
    "./session/tree": {
      "types": "./src/session/tree.ts",
      "default": "./src/session/tree.ts"
    },
    "./session/pg-repo": {
      "types": "./src/session/pg-repo.ts",
      "default": "./src/session/pg-repo.ts"
    },
    "./session/usage": {
      "types": "./src/session/usage.ts",
      "default": "./src/session/usage.ts"
    },
    "./system/DO_NOT_USE_OR_YOU_WILL_BE_FIRED": {
      "types": "./src/system/DO_NOT_USE_OR_YOU_WILL_BE_FIRED.ts",
      "default": "./src/system/DO_NOT_USE_OR_YOU_WILL_BE_FIRED.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@chia/ai": "workspace:*",
    "@chia/db": "workspace:*",
    "@chia/observability": "workspace:*",
    "@chia/utils": "workspace:*",
    "@opentelemetry/api": "catalog:otel",
    "@tanstack/ai": "catalog:agent",
    "@tanstack/ai-anthropic": "catalog:agent",
    "@tanstack/ai-openai": "catalog:agent",
    "@tanstack/ai-vercel-gateway": "catalog:agent",
    "es-toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@opentelemetry/context-async-hooks": "catalog:otel",
    "@opentelemetry/sdk-trace-base": "catalog:otel",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
