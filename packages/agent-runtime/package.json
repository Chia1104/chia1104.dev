{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./events": {
      "types": "./src/wire/schema.ts",
      "default": "./src/wire/schema.ts"
    },
    "./transports/tanstack-ai": {
      "types": "./src/transports/tanstack-ai.ts",
      "default": "./src/transports/tanstack-ai.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@chia/db": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:agent",
    "@earendil-works/pi-ai": "catalog:agent",
    "@tanstack/ai": "catalog:agent-client",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chiastack/tsconfig": "catalog:chiastack",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
