{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/agent-writing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./ports": {
      "types": "./src/ports.ts",
      "default": "./src/ports.ts"
    },
    "./models": {
      "types": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "default": "./src/policy.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./draft": {
      "types": "./src/draft/index.ts",
      "default": "./src/draft/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@chia/agent-runtime": "workspace:*",
    "@chia/ai": "workspace:*",
    "@chia/db": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:agent",
    "@earendil-works/pi-ai": "catalog:agent",
    "github-slugger": "^2.0.0",
    "typebox": "catalog:agent",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chiastack/tsconfig": "catalog:chiastack",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
