{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/kv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./clients": {
      "types": "./src/clients.ts",
      "default": "./src/clients.ts"
    },
    "./postgres": {
      "types": "./src/adapters/postgres.ts",
      "default": "./src/adapters/postgres.ts"
    },
    "./redis": {
      "types": "./src/adapters/redis.ts",
      "default": "./src/adapters/redis.ts"
    },
    "./valkey": {
      "types": "./src/adapters/valkey.ts",
      "default": "./src/adapters/valkey.ts"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "default": "./src/provider.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./upstash": {
      "types": "./src/upstash/client.ts",
      "default": "./src/upstash/client.ts"
    },
    "./upstash/with-rate-limiter": {
      "types": "./src/upstash/with-rate-limiter.ts",
      "default": "./src/upstash/with-rate-limiter.ts"
    },
    "./drizzle/cache": {
      "types": "./src/drizzle/cache.ts",
      "default": "./src/drizzle/cache.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type:check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@chia/utils": "workspace:*",
    "@keyv/postgres": "^2.2.3",
    "@keyv/redis": "^5.1.6",
    "@keyv/valkey": "^1.0.11",
    "@t3-oss/env-core": "catalog:",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.3",
    "drizzle-orm": "catalog:drizzle",
    "keyv": "^5.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@keyv/test-suite": "^2.1.2",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
