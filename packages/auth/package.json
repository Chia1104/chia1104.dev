{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./oauth": {
      "types": "./src/oauth.ts",
      "default": "./src/oauth.ts"
    },
    "./apikey": {
      "types": "./src/apikey.ts",
      "default": "./src/apikey.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./tier": {
      "types": "./src/tier.ts",
      "default": "./src/tier.ts"
    },
    "./access": {
      "types": "./src/access.ts",
      "default": "./src/access.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type:check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@chia/db": "workspace:*",
    "@chia/utils": "workspace:*",
    "@t3-oss/env-core": "catalog:env",
    "client-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
