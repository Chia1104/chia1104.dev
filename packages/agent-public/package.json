{
  "$schema": "https://json.schemastore.org/package",
  "name": "@chia/agent-public",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./models": {
      "types": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "default": "./src/policy.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@chia/agent-content": "workspace:*",
    "@chia/agent-runtime": "workspace:*",
    "@chia/ai": "workspace:*",
    "@chia/db": "workspace:*",
    "@chia/observability": "workspace:*",
    "@earendil-works/pi-ai": "catalog:agent",
    "es-toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chia/agent-writing": "workspace:*",
    "@chia/test": "workspace:*",
    "@chiastack/tsconfig": "catalog:chiastack",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  }
}
