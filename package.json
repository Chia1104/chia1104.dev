{
  "$schema": "https://json.schemastore.org/package",
  "name": "chia1104.dev",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Chia1104",
    "email": "yuyuchia7423@gmail.com",
    "url": "https://github.com/chia1104"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "toolings/**/*",
    "tests/*"
  ],
  "sideEffects": false,
  "scripts": {
    "postinstall": "manypkg check",
    "prepare": "husky",
    "build": "turbo run build",
    "build:www": "turbo run build --filter www...",
    "build:dash": "turbo run build --filter dash...",
    "build:service": "turbo run build --filter service...",
    "build:workflow": "turbo run build --filter workflow-service...",
    "dev": "turbo run dev --continue --concurrency=15",
    "dev:turbo": "turbo run dev:turbo --continue",
    "dev:www": "turbo run dev --filter www... --filter service... --filter workflow-service... --concurrency=13 --continue",
    "dev:dash": "turbo run dev --filter dash... --filter service... --filter workflow-service... --concurrency=13 --continue",
    "dev:service": "turbo run dev --filter service... --filter workflow-service... --concurrency=12 --continue",
    "start": "turbo run start --parallel",
    "start:www": "turbo run start --filter www",
    "start:dash": "turbo run start --filter dash",
    "start:service": "turbo run start --filter service",
    "start:workflow": "turbo run start --filter workflow-service",
    "lint": "turbo run lint --continue",
    "lint:www": "turbo run lint --filter www... --continue",
    "lint:dash": "turbo run lint --filter dash... --continue",
    "lint:service": "turbo run lint --filter service... --continue",
    "lint:workflow": "turbo run lint --filter workflow-service... --continue",
    "lint:fix": "turbo run lint:fix --continue",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type:check": "turbo run type:check --parallel",
    "clean": "git clean -xdf node_modules .cache",
    "clean:workspaces": "turbo clean --parallel",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:up": "docker compose --env-file .env.global up -d",
    "db:down": "docker compose --env-file .env.global down",
    "service:up": "docker compose --env-file .env.global --profile app up --build",
    "service:down": "docker compose --env-file .env.global --profile app down",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:pull": "turbo run db:pull",
    "db:push": "cd packages/db && pnpm run db:push",
    "db:init": "turbo run db:init --parallel",
    "db:seed": "turbo run db:seed --parallel",
    "db:studio": "turbo run db:studio --parallel",
    "test:e2e": "turbo run test:e2e",
    "seed": "turbo run db:seed --filter seed",
    "service-graph": "turbo run build --filter service... --graph=graph/service-graph.html",
    "www-graph": "turbo run build --filter www... --graph=graph/www-graph.html",
    "dash-graph": "turbo run build --filter dash... --graph=graph/dash-graph.html",
    "graph": "nx graph",
    "ui-add": "turbo run ui-add",
    "update-deps:all": "pnpm up --latest --filter '@chia/*' --filter www --filter dash --filter service --filter '*-service'",
    "debug:build": "turbo run debug:build --parallel",
    "debug:start": "turbo run debug:start --parallel",
    "devtools": "turbo devtools"
  },
  "devDependencies": {
    "@chiastack/oxlint": "catalog:chiastack",
    "@manypkg/cli": "catalog:tooling",
    "@oxlint/plugins": "catalog:oxc",
    "@playwright/test": "catalog:testing-library",
    "@total-typescript/ts-reset": "catalog:tooling",
    "@turbo/gen": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:testing-library",
    "@vitest/ui": "catalog:testing-library",
    "cross-env": "catalog:tooling",
    "eslint-plugin-turbo": "catalog:tooling",
    "happy-dom": "catalog:testing-library",
    "husky": "catalog:tooling",
    "lint-staged": "catalog:tooling",
    "msw": "catalog:testing-library",
    "nx": "catalog:tooling",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "railway": "catalog:tooling",
    "tsx": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:",
    "vitest": "catalog:testing-library"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,mts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22",
    "pkl": ">=0.25.2"
  },
  "packageManager": "pnpm@12.1.0",
  "manypkg": {
    "ignoredRules": [
      "ROOT_HAS_PROD_DEPENDENCIES"
    ],
    "workspaceProtocol": "require"
  }
}
