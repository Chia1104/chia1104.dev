{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/apps/workflow",
      "/packages/agent-content",
      "/packages/agent-host",
      "/packages/agent-runtime",
      "/packages/agent-writing",
      "/packages/ai",
      "/packages/api",
      "/packages/db",
      "/packages/service-kit",
      "/packages/utils",
      "/packages/workflow-control",
      "/infra/railway/workflow.json",
      "package.json",
      "Dockerfile.workflow",
      "turbo.json"
    ],
    "dockerfilePath": "Dockerfile.workflow"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
